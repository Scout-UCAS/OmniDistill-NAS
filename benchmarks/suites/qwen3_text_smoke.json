{
  "schema_version": 1,
  "name": "qwen3-text-smoke",
  "description": "Qwen-style text-model smoke benchmark. This suite is intended for GPU hosts with model access.",
  "benchmarks": [
    {
      "id": "qwen3_0_6b_mmlu_smoke",
      "task": "text-lm-mmlu-smoke",
      "backend": "qwen",
      "command": [
        "python3",
        "tools/run_qwen3_attention_search.py",
        "--model-id",
        "Qwen/Qwen3-0.6B",
        "--device",
        "gpu",
        "--prompt-source",
        "mmlu",
        "--max-prompts",
        "2",
        "--max-layers",
        "1",
        "--variants",
        "parent,parent_attn,mha_attn,quant_mha_attn,mqa_attn,gqa_kv2,linear_attn,noop_attn"
      ],
      "tags": ["qwen3", "text", "mmlu", "gpu"],
      "expected_metrics": ["loss", "runtime", "parameter_memory_bytes"]
    }
  ]
}
