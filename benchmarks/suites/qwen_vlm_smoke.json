{
  "schema_version": 1,
  "name": "qwen-vlm-smoke",
  "description": "Qwen-style vision-language smoke benchmark for language decoder replacement.",
  "benchmarks": [
    {
      "id": "qwen3_vl_decoder_smoke",
      "task": "vision-language-decoder-compression",
      "backend": "vlm",
      "command": [
        "python3",
        "tools/run_qwen3_attention_search.py",
        "--model-id",
        "Qwen/Qwen3-VL-2B-Instruct",
        "--model-kind",
        "vlm",
        "--device",
        "gpu",
        "--allow-blank-image",
        "--max-prompts",
        "1",
        "--max-layers",
        "1",
        "--variants",
        "parent,parent_attn,mha_attn,quant_mha_attn,mqa_attn,linear_attn,noop_attn"
      ],
      "tags": ["qwen-vl", "vlm", "gpu"],
      "expected_metrics": ["loss", "runtime", "parameter_memory_bytes"]
    }
  ]
}
